---
import Gauge from "./Gauge.astro";
---

<div class="w-full max-w-sm rounded-2xl border border-solid border-surface-border bg-surface p-6 shadow-2xl shadow-black/40">
	<div class="mb-5 flex items-center justify-between">
		<span class="text-sm font-medium text-text-primary">Résidence Étoile, Douala</span>
		<span class="flex items-center gap-1.5 text-xs text-emerald">
			<span class="relative flex h-2 w-2">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald opacity-60"></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald"></span>
			</span>
			Synchronisé
		</span>
	</div>

	<div class="flex items-center justify-around gap-4 py-2">
		<Gauge value={78} label="Taux d'occupation" />
		<Gauge value={32} max={42} unit="" label="Chambres actives" />
	</div>

	<div class="mt-5 flex items-center justify-between border-t border-solid border-surface-border pt-4">
		<span class="text-xs text-text-secondary">Écart de caisse aujourd'hui</span>
		<span class="tabular font-display text-lg font-medium text-emerald-bright">0 FCFA</span>
	</div>
</div>
