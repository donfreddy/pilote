---
import { Bed, Wine, UtensilsCrossed, Package, CalendarDays, Wallet } from "lucide-react";

const modules = [
	{
		icon: Bed,
		name: "Réception & Chambres",
		detail: "Planning unifié, blocage des nuitées fantômes et libération automatique des chambres à l'impayé.",
	},
	{
		icon: Wine,
		name: "Bar & Maquis",
		detail: "Chaque boisson sortie est adossée à une table, transférée aussitôt sur la note de chambre.",
	},
	{
		icon: UtensilsCrossed,
		name: "Restaurant & Cuisine",
		detail: "Pas de bon de commande, pas de plat en cuisine : plus d'addition réglée en douce.",
	},
	{
		icon: Wallet,
		name: "Caisse",
		detail: "Rapprochement automatique de tous les encaissements, écarts signalés immédiatement au promoteur.",
	},
	{
		icon: Package,
		name: "Économat & Blanchisserie",
		detail: "Linge de chambre et réserve de boissons suivis un par un, pour stopper le coulage.",
	},
	{
		icon: CalendarDays,
		name: "Salles & Événements",
		detail: "Acomptes, réservations de salle et facturation des banquets et séminaires.",
	},
];
---

<section id="modules" class="border-b border-solid border-surface-border bg-background py-20">
	<div class="mx-auto max-w-6xl px-6">
		<div class="max-w-xl">
			<h2 class="font-display text-3xl font-medium text-text-primary sm:text-4xl">
				Un seul tableau de bord pour verrouiller toutes vos sources de revenus.
			</h2>
			<p class="mt-4 text-text-secondary">
				Réception, bar, restaurant, économat, événements : chaque source de
				revenu remonte au même tableau, comme les disjoncteurs d'une
				installation électrique.
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-solid border-surface-border bg-surface-border sm:grid-cols-2 lg:grid-cols-3">
			{modules.map(({ icon: Icon, name, detail }) => (
				<div class="flex flex-col gap-3 bg-surface p-6">
					<div class="flex items-center gap-3">
						<span class="flex h-9 w-9 items-center justify-center rounded-md border border-solid border-surface-border text-gold">
							<Icon className="h-5 w-5" strokeWidth={2} />
						</span>
						<span class="font-medium text-text-primary">{name}</span>
					</div>
					<p class="text-sm text-text-secondary">{detail}</p>
				</div>
			))}
		</div>
	</div>
</section>
