---
import { FileClock, Lock, ShieldCheck, Smartphone, Headset } from "lucide-react";

const pillars = [
	{
		icon: Lock,
		title: "Contrôle d'accès & Droits par rôle",
		detail:
			"Le réceptionniste enregistre les entrées mais ne peut ni modifier un tarif, ni annuler un encaissement, ni voir la trésorerie globale : de quoi couper court aux abus, sans jamais accuser votre personnel honnête sans preuve. Seul le promoteur détient les clés de validation.",
	},
	{
		icon: ShieldCheck,
		title: "Vos données restent chez vous, sauvegardées en continu",
		detail:
			"Hébergement sécurisé, sauvegardes automatiques régulières. Vos données financières et opérationnelles ne sont jamais partagées ni revendues.",
	},
	{
		icon: FileClock,
		title: "Chaque geste sensible horodaté et attribué",
		detail:
			"Chambre mise « hors service », tarif modifié, commande annulée : l'action est enregistrée avec l'heure et le nom de l'employé, consultable à tout moment depuis votre téléphone.",
	},
	{
		icon: Smartphone,
		title: "Prise en main en 15 minutes",
		detail:
			"Interface pensée pour vos réceptionnistes, gérants et serveurs, sans prérequis informatique. Vos équipes sont autonomes dès le premier jour.",
	},
	{
		icon: Headset,
		title: "Assistance sur WhatsApp, 7j/7",
		detail:
			"Le même canal que vos équipes utilisent déjà. Un blocage un dimanche soir : un conseiller répond et résout le problème en direct.",
	},
];
---

<section id="confiance" class="border-b border-solid border-surface-border bg-background py-20">
	<div class="mx-auto max-w-6xl px-6">
		<div class="max-w-2xl">
			<h2 class="font-display text-3xl font-medium text-text-primary sm:text-4xl">
				Cinq garanties pour dormir tranquille, même loin de l'hôtel.
			</h2>
			<p class="mt-4 text-text-secondary">
				Pas de théorie : un logiciel construit pour continuer à protéger vos
				recettes, quelles que soient les conditions locales.
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{pillars.map(({ icon: Icon, title, detail }) => (
				<div class="rounded-xl border border-solid border-surface-border bg-surface p-6">
					<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-2 text-gold">
						<Icon className="h-5 w-5" strokeWidth={2} />
					</span>
					<p class="mt-4 font-display text-lg font-medium text-text-primary">{title}</p>
					<p class="mt-2 text-sm leading-relaxed text-text-secondary">{detail}</p>
				</div>
			))}
		</div>
	</div>
</section>
