---
import WhatsAppPreview from "./WhatsAppPreview.astro";
import { buildWhatsAppLink, WHATSAPP_DEFAULT_MESSAGE } from "../data/config";
---

<section id="hero" class="relative overflow-hidden border-b border-solid border-surface-border">
	<div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 py-10 md:grid-cols-2 md:items-center md:py-24">
		<div class="rise-in flex flex-col items-start gap-5 text-left md:gap-6">
			<span class="inline-flex items-center whitespace-nowrap rounded-full border border-solid border-surface-border bg-surface px-3.5 py-1.5 text-xs font-medium text-text-secondary">
				Pour hôtels & résidences de 10 à 50+ chambres
			</span>

			<h1 class="font-display text-3xl font-medium leading-[1.1] tracking-tight text-text-primary sm:text-4xl md:text-5xl">
				Ne perdez plus un franc sur les recettes que vous ne voyez pas.
			</h1>
			<p class="max-w-md text-base text-text-secondary sm:text-lg">
				Pilote réunit réception, bar, restaurant et caisse dans un seul
				panneau. Vous voyez chaque franc encaissé, même en voyage, même sans
				internet.
			</p>

			<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
				<a
					href="#demo"
					class="inline-flex items-center justify-center rounded-md border border-solid border-gold bg-gold px-6 py-3 font-sans text-sm font-semibold text-[#241c08] transition-colors hover:bg-gold-bright"
				>
					Demander une démo
				</a>
				<a
					href={buildWhatsAppLink(WHATSAPP_DEFAULT_MESSAGE)}
					target="_blank"
					rel="noopener noreferrer"
					class="text-sm font-medium text-text-secondary underline decoration-surface-border underline-offset-4 transition-colors hover:text-text-primary"
				>
					Ou écrivez-nous directement sur WhatsApp
				</a>
			</div>

			<p class="text-xs text-text-muted">
				Sans engagement • Réponse WhatsApp sous 2h, 7j/7
			</p>
		</div>

		<div class="relative flex items-center justify-center md:justify-end">
			<div
				class="pointer-events-none absolute inset-0 -z-10"
				aria-hidden="true"
				style="background: radial-gradient(130% 110% at 65% 5%, color-mix(in srgb, var(--color-emerald) 14%, transparent), transparent 70%)"
			></div>

			<svg
				viewBox="0 22 260 108"
				aria-hidden="true"
				class="pointer-events-none absolute right-0 top-0 -z-10 h-46 w-110 -translate-y-14 opacity-40 md:opacity-60"
			>
				<defs>
					<linearGradient id="hero-gauge-grad" x1="0" y1="1" x2="1" y2="1">
						<stop offset="0" stop-color="var(--color-emerald)"></stop>
						<stop offset="0.6" stop-color="var(--color-gold)"></stop>
						<stop offset="1" stop-color="var(--color-gold-bright)"></stop>
					</linearGradient>
				</defs>
				<path d="M 42 120 A 88 88 0 0 1 218 120" fill="none" stroke="var(--color-surface-border)" stroke-width="5" stroke-linecap="round"></path>
				<path
					d="M 42 120 A 88 88 0 0 1 218 120"
					fill="none"
					stroke="url(#hero-gauge-grad)"
					stroke-width="5"
					stroke-linecap="round"
					stroke-dasharray="276.5"
					stroke-dashoffset="41.5"
					class="gauge-sweep"
					style="--gauge-empty: 276.5; --gauge-value: 41.5"
				></path>
				<line x1="130" y1="120" x2="208" y2="79" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round"></line>
				<circle cx="130" cy="120" r="5.5" fill="var(--color-gold)"></circle>
			</svg>

			<WhatsAppPreview />
		</div>
	</div>
</section>
