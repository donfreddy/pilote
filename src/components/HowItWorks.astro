---
const steps = [
	{
		title: "Démo personnalisée, 20 minutes",
		detail:
			"Un échange sur WhatsApp, sans engagement. Nous regardons vos vrais chiffres et où partent vos fuites de caisse.",
	},
	{
		title: "Déploiement clé en main en 48h",
		detail:
			"Nous configurons chambres, tarifs et cartes du bar et du restaurant. Votre équipe est formée sur place, sans ressaisie de votre côté. Ça tourne sur vos tablettes ou ordinateurs existants, aucun matériel à acheter.",
	},
	{
		title: "Pilotage à distance",
		detail:
			"Dès le troisième jour, vos encaissements cash et mobile money arrivent en direct sur votre téléphone, où que vous soyez.",
	},
];
---

<section class="border-b border-solid border-surface-border bg-surface py-20">
	<div class="mx-auto max-w-6xl px-6">
		<div class="max-w-2xl">
			<h2 class="font-display text-3xl font-medium text-text-primary sm:text-4xl">
				Opérationnel en 3 étapes, sans interrompre votre activité.
			</h2>
			<p class="mt-4 text-text-secondary">
				Aucune compétence informatique requise : nous prenons en charge la
				configuration complète de votre établissement.
			</p>
		</div>

		<div class="relative mt-12 max-w-2xl">
			<div class="absolute left-4 top-4 bottom-4 w-px bg-gold/40" aria-hidden="true"></div>
			<ol class="relative flex flex-col gap-10">
				{steps.map((step, index) => (
					<li class="flex items-start gap-5">
						<span class="tabular relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-solid border-gold bg-surface font-display text-sm text-gold">
							{index + 1}
						</span>
						<div class="flex flex-col gap-1.5 pt-1">
							<span class="font-medium text-text-primary">{step.title}</span>
							<p class="text-sm text-text-secondary">{step.detail}</p>
						</div>
					</li>
				))}
			</ol>
		</div>

		<a
			href="#demo"
			class="mt-10 inline-flex items-center gap-1.5 text-sm font-medium text-gold underline decoration-gold/40 underline-offset-4 transition-colors hover:text-gold-bright"
		>
			Réserver ma démo de 20 minutes →
		</a>
	</div>
</section>
