---
import { BadgeCheck, Check, CheckCheck, Phone, Video } from "lucide-react";
---

<div class="w-full max-w-sm overflow-hidden rounded-2xl border border-solid border-surface-border bg-surface shadow-2xl shadow-black/40">
	<div class="flex items-center gap-2.5 border-b border-solid border-surface-border bg-surface-2 px-4 py-3">
		<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald/20 font-display text-sm font-medium text-emerald-bright">
			P
		</span>
		<div class="flex min-w-0 flex-col">
			<span class="flex items-center gap-1 text-sm font-medium text-text-primary">
				Pilote
				<BadgeCheck className="h-3.5 w-3.5 shrink-0 text-emerald-bright" strokeWidth={2.5} />
			</span>
			<span class="truncate text-[11px] text-text-muted">Compte professionnel · en ligne</span>
		</div>
		<div class="ml-auto flex items-center gap-3 text-text-muted">
			<Video className="h-4 w-4" strokeWidth={1.75} />
			<Phone className="h-4 w-4" strokeWidth={1.75} />
		</div>
	</div>

	<div class="flex flex-col gap-3 bg-[radial-gradient(circle,_color-mix(in_srgb,_white_4%,_transparent)_1px,_transparent_1px)] bg-[length:14px_14px] p-4">
		<span class="mx-auto rounded-md bg-surface-2 px-2.5 py-1 text-[11px] text-text-muted">Aujourd'hui</span>

		<div class="rounded-2xl rounded-tl-sm bg-surface-2 p-4">
			<p class="text-sm font-medium text-text-primary">Clôture du 24 septembre</p>
			<div class="mt-3 flex flex-col gap-2 text-sm text-text-secondary">
				<div class="flex items-center justify-between">
					<span>Occupation</span>
					<span class="tabular font-medium text-text-primary">17/20 chambres</span>
				</div>
				<div class="flex items-center justify-between">
					<span>Chiffre d'affaires</span>
					<span class="tabular font-display font-medium text-text-primary">356{" "}000 FCFA</span>
				</div>
				<div class="flex items-center justify-between">
					<span>Statut de caisse</span>
					<span class="flex items-center gap-1.5 font-medium text-emerald-bright">
						<Check className="h-3.5 w-3.5" strokeWidth={2.5} />
						Aucun écart
					</span>
				</div>
			</div>
			<div class="mt-3 flex items-center justify-end gap-1 text-text-muted">
				<span class="text-[11px]">23:04</span>
				<CheckCheck className="h-3.5 w-3.5" strokeWidth={2} />
			</div>
		</div>
	</div>
</div>
