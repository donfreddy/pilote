---
import { Banknote, Smartphone, CreditCard, ShieldCheck } from "lucide-react";

const methods = [
	{ icon: Banknote, name: "Espèces" },
	{ icon: Smartphone, name: "Orange Money" },
	{ icon: Smartphone, name: "MTN MoMo" },
	{ icon: CreditCard, name: "Carte" },
];

const breakdown = [
	{ label: "Espèces", amount: "125 000" },
	{ label: "Mobile Money", amount: "137 500" },
	{ label: "Carte", amount: "50 000" },
];
---

<section id="encaissements" class="border-b border-solid border-surface-border bg-background py-20">
	<div class="mx-auto max-w-6xl px-6">
		<div class="max-w-2xl">
			<h2 class="font-display text-3xl font-medium text-text-primary sm:text-4xl">
				Cash, Mobile Money ou carte : zéro franc dans la nature.
			</h2>
			<p class="mt-4 text-text-secondary">
				Votre équipe enregistre le mode d'encaissement et la référence de
				transaction en deux clics. Pilote ventile les flux et prépare le
				pointage de caisse, sans traiter lui-même le paiement.
			</p>
		</div>

		<div class="mt-12 flex flex-col items-center gap-6">
			<div class="flex flex-wrap items-center justify-center gap-3">
				{methods.map(({ icon: Icon, name }) => (
					<span class="flex items-center gap-2 rounded-full border border-solid border-surface-border bg-surface px-4 py-2 text-sm text-text-secondary">
						<Icon className="h-4 w-4" strokeWidth={2} />
						{name}
					</span>
				))}
			</div>

			<div class="h-10 w-px bg-linear-to-b from-surface-border to-gold"></div>

			<div class="flex w-full max-w-md flex-col items-center gap-1 rounded-xl border border-solid border-gold/40 bg-surface p-6 text-center">
				<span class="flex items-center gap-1.5 text-xs font-medium text-emerald-bright">
					<ShieldCheck className="h-3.5 w-3.5" strokeWidth={2} />
					Pointage du jour verrouillé, écart 0 FCFA
				</span>
				<span class="tabular font-display text-3xl font-medium text-text-primary">312{" "}500 FCFA</span>

				<div class="mt-3 grid w-full grid-cols-3 gap-2 border-t border-solid border-surface-border pt-3 text-xs text-text-secondary">
					{breakdown.map(({ label, amount }) => (
						<div class="flex flex-col items-center gap-0.5">
							<span>{label}</span>
							<span class="tabular font-medium text-text-primary">{amount}</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
