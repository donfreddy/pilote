---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Pilote, le panneau de contrôle de votre hôtel",
	description = "Réception, bar, restaurant et caisse dans un seul panneau. Gardez le contrôle de votre hôtel même sans internet, même en voyage.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<script is:inline>
			if (localStorage.getItem("pilote-theme") === "dark") {
				document.documentElement.setAttribute("data-theme", "dark");
			}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
