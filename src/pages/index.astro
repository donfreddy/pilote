---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import PainComparison from "../components/PainComparison.astro";
import ImpactBanner from "../components/ImpactBanner.astro";
import Trust from "../components/Trust.astro";
import Testimonials from "../components/Testimonials.astro";
import Modules from "../components/Modules.astro";
import Offline from "../components/Offline.astro";
import Payments from "../components/Payments.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Footer from "../components/Footer.astro";
import StickyWhatsapp from "../components/react/StickyWhatsapp";
---

<Layout>
	<Nav />
	<main>
		<Hero />
		<PainComparison />
		<ImpactBanner />
		<Trust />
		<Testimonials />
		<Modules />
		<Offline />
		<Payments />
		<HowItWorks />
	</main>
	<Footer />
	<StickyWhatsapp client:load />
</Layout>
