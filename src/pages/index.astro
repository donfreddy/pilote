---
import Layout from "../layouts/Layout.astro";
import Counter from "../components/react/Counter";
---

<Layout title="Pilote" description="Pilote.">
	<main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
		<h1 class="animate-rise font-sans text-4xl font-semibold tracking-tight sm:text-5xl">
			<span class="gradient-text">Pilote</span>
		</h1>
		<p class="max-w-md text-text-secondary">
			Base Astro + React prête. À construire.
		</p>
		<Counter client:load />
	</main>
</Layout>
